# Shared
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/omni_rag
POSTGRES_DB=omni_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Shared by both backends. Generate once and keep it stable; changing it makes
# existing encrypted per-company provider keys unreadable.
LLM_CREDENTIALS_KEY=
# Container-reachable endpoints used by docker-compose.yml
DOCKER_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/omni_rag
DOCKER_QDRANT_URL=http://qdrant:6333
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
DOCKER_UPLOAD_DIR=/app/.data/uploads
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
EMBEDDING_MODEL=nomic-embed-text
# Comma-separated model choices exposed by the Admin API and company form.
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
ANTHROPIC_API_URL=https://api.anthropic.com/v1
ANTHROPIC_MODELS=claude-haiku-4-5-20251001,claude-sonnet-5,claude-opus-5
HUGGINGFACE_API_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODELS=Qwen3.8-27B,DeepSeek-R1,DeepSeek-V4.1-Flash,gemma4-31B
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELS=gemma4:12b
UPLOAD_DIR=.data/uploads
WEB_FETCH_TIMEOUT=15
WEB_FETCH_MAX_BYTES=5242880
WEB_FETCH_MAX_REDIRECTS=5
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_API_URL=http://localhost:8001
CHATBOT_API_URL=http://localhost:8002
CHAT_SESSION_MINUTES=10
CHAT_SESSION_SWEEP_SECONDS=5

# Frontends (copy relevant values to each UI .env)
VITE_ADMIN_API_URL=http://localhost:8001/api/v1
VITE_CHAT_API_URL=http://localhost:8002/api/v1
VITE_CHATBOT_UI_URL=http://localhost:5174
VITE_CHAT_IDLE_SECONDS=60
